{
  "name": "reduxed-chrome-storage",
  "type": "module",
  "version": "3.5.0",
  "description": "Redux interface to chrome.storage (browser.storage). Unified way to use Redux in all modern browser extensions",
  "license": "MIT",
  "author": "Savr Goryaev aka hindmost",
  "repository": "github:hindmost/reduxed-chrome-storage",
  "bugs": "https://github.com/hindmost/reduxed-chrome-storage/issues",
  "keywords": [
    "redux",
    "chrome",
    "extension",
    "chrome-extension",
    "storage",
    "chrome-storage",
    "browser-extension",
    "webextension",
    "store",
    "state"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
